# Shadow Accountant env. Names only; never commit real values. Copy to .env.local for local dev.

# Supabase VA
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the deployed app, e.g. https://shadow.aiaccountant.com. Used for the Microsoft sign-in redirect (safer than request headers). Leave blank locally.
NEXT_PUBLIC_SITE_URL=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (Vercel AI SDK). Models the old council used:
#   OPENROUTER_MODEL_A=anthropic/claude-sonnet-5
#   OPENROUTER_MODEL_B=openai/gpt-5.6-luna
# Embedding model must output 1536 dimensions (DB column is vector(1536)).
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=
OPENROUTER_MODEL_B=
OPENROUTER_EMBED_MODEL=

# Scheduled jobs (vercel.json crons). Job routes require "Authorization: Bearer $CRON_SECRET".
# Vercel Cron sends this header automatically once CRON_SECRET is set in the Vercel project.
CRON_SECRET=
# Jobs (health score, council, HubSpot sync, embeddings) and the HubSpot webhook are dry-run unless this
# is "true" AND the job is listed in JOBS_WRITE_ONLY. Read README.md before turning either on.
JOBS_WRITE_ENABLED=false
# Comma list of jobs allowed to write when JOBS_WRITE_ENABLED=true, so each job is approved on its own:
# health-score, council, hubspot-sync (also the webhook), embed. Blank = no job writes (fails closed).
JOBS_WRITE_ONLY=
# Council start date (IST, YYYY-MM-DD): the council only reads messages from 00:00 IST that day; older ones are
# never voted on. Pilot demo: 30 days back. Go-live: the launch day. Blank = every unprocessed message. A bad value fails the run.
COUNCIL_START_DATE=
# true = the daily health score covers only clients with the council on (others have no tickets yet). Set false at go-live.
HEALTH_SCORE_PILOT_ONLY=

# HubSpot (private app token and webhook signing secret = the app's client secret)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
# VA client rule (specs/hubspot-sync-v2.md). Blank = the live portal's ids below.
# Active client = deal in this pipeline, has entered the paid stage once, and is in one of the active stages.
HUBSPOT_VA_PIPELINE_ID=1534965463
HUBSPOT_VA_PAID_STAGE_ID=2462646003
# Payment Done, Ready for Renewal, Renewal Done
HUBSPOT_VA_ACTIVE_STAGE_IDS=2462646003,3668025064,3102360263
# Deals never treated as clients (test deals), comma list. 337128679127 = "Tester Mrinal coder".
HUBSPOT_IGNORE_DEAL_IDS=337128679127
# Push va_* properties to HubSpot deals. Keep false: those properties do not exist in HubSpot yet.
HUBSPOT_PUSH_ENABLED=false

# Dev login: only used when NODE_ENV is not production. Leave blank in production.
DEV_LOGIN_EMAIL=
# Dev login only: senior_accountant | admin | engineer. Blank = role from the vas email match.
DEV_LOGIN_ROLE=

# IANA timezone for business hours, score dates and chat times. Defaults to Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata
