# Shadow Accounting env. Names only; never commit real values. Copy to .env.local for local dev.

# Supabase VA
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (Vercel AI SDK). Models the old council used:
#   OPENROUTER_MODEL_A=anthropic/claude-sonnet-5
#   OPENROUTER_MODEL_B=openai/gpt-5.6-luna
# Embedding model must output 1536 dimensions (DB column is vector(1536)).
OPENROUTER_API_KEY=
OPENROUTER_MODEL_A=
OPENROUTER_MODEL_B=
OPENROUTER_EMBED_MODEL=

# Scheduled jobs (vercel.json crons). Job routes require "Authorization: Bearer $CRON_SECRET".
# Vercel Cron sends this header automatically once CRON_SECRET is set in the Vercel project.
CRON_SECRET=
# Jobs (health score, council, HubSpot sync, embeddings) and the HubSpot webhook are dry-run unless this
# is "true" AND the job is listed in JOBS_WRITE_ONLY. Read README.md before turning either on.
JOBS_WRITE_ENABLED=false
# Comma list of jobs allowed to write when JOBS_WRITE_ENABLED=true, so each job is approved on its own:
# health-score, council, hubspot-sync (also the webhook), embed. Blank = no job writes (fails closed).
JOBS_WRITE_ONLY=

# HubSpot (private app token and webhook signing secret = the app's client secret)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
# Comma separated closed-won deal stage ids. A deal in one of these stages counts as paid: its amount is
# copied to clients.amount_paid and a new client is created. Blank = amounts and new clients are skipped.
HUBSPOT_WON_STAGE_IDS=

# Dev login: only used when NODE_ENV is not production. Leave blank in production.
DEV_LOGIN_EMAIL=
# Dev login only: senior_accountant | admin | engineer. Blank = role from the vas email match.
DEV_LOGIN_ROLE=

# IANA timezone for business hours, score dates and chat times. Defaults to Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata
